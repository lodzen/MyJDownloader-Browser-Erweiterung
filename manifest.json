{
"update_url": "https://clients2.google.com/service/update2/crx",

  "description": "__MSG_extensionDescription__",
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "MyJDownloader",
  "version": "3.3.20",
  "author": "AppWork GmbH",
  "homepage_url": "https://my.jdownloader.org",
  "icons": {
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:9666/*",
    "http://localhost:9666/*",
    "https://my.jdownloader.org/*",
    "http://my.jdownloader.org/*"
  ],
  "background": {
    "service_worker": "scripts/background_service_worker.js"
  },
  "action": {
    "default_icon": "images/icon32.png",
    "default_title": "MyJDownloader",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "index.html#!/settings"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "toolbar.html",
        "autograbber-indicator.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-clipboard-observer": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "__MSG_toggle_clipboard_observer__"
    },
    "auto-grab-downloads": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_toggle_auto_grab_links__"
    }
  },
  "content_scripts": [
    {
      "js": [
        "contentscripts/onCopyContentscript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "js": [
        "contentscripts/toolbarContentscript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "js": [
        "contentscripts/selectionContentscript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "default_locale": "en"
}